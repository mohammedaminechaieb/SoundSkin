<?xml version="1.0" encoding="utf-8"?>
<!-- Only key filtering is needed. No window-content access and the
     narrowest event type, so the service genuinely can't read the screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="100"
    android:settingsActivity="com.soundskin.app.MainActivity"
    android:description="@string/accessibility_service_description" />
